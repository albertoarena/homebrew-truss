# macOS
.DS_Store

# IDE files
/.idea/
/.vscode/
/.fleet/
/.zed/
*.iml
*.sublime-project
*.sublime-workspace
*.swp
*~

# Private/local docs. No trailing slash on purpose: a trailing slash matches
# directories only, so the entry would not cover a symlink of the same name,
# and git records a symlink as a file. Without the slash it covers both.
/.docs

# Local Claude files
CLAUDE.local.md
CLAUDE.*.local.md
